<?xml version="1.0"?>
<!-- Sensors on the sprung body. Gazebo's sensor systems are loaded with the robot,
     so every world gets them. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU errors per axis (assumed, typical of an industrial MEMS IMU): white noise per sample,
       a bias drawn at start-up, and a slowly drifting bias with long-run spread 'drift' and
       correlation time 'corr_time'. Gazebo's dynamic_bias_stddev is a noise density: its
       long-run spread is dynamic_bias_stddev * sqrt(corr_time / 2), hence the conversion. -->
  <xacro:macro name="imu_noise" params="axis white bias drift corr_time">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0</mean>
        <stddev>${white}</stddev>
        <bias_mean>0</bias_mean>
        <bias_stddev>${bias}</bias_stddev>
        <dynamic_bias_stddev>${drift * sqrt(2.0 / corr_time)}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${corr_time}</dynamic_bias_correlation_time>
      </noise>
    </xacro:element>
  </xacro:macro>

  <!-- IMU: accelerometer and gyroscope with noise and biases, published on /imu. Like the
       real robot's inertial unit, it sits under the roof at the back (Esser et al. 2023).
       Its orientation output stays perfect in Gazebo, so the localization does not use it. -->
  <xacro:macro name="imu_sensor" params="x z rate">
    <link name="imu_link">
      <visual>
        <geometry><box size="0.16 0.12 0.06"/></geometry>
        <material name="scanner_blue"/>
      </visual>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <imu>
          <angular_velocity>
            <xacro:imu_noise axis="x" white="0.0005" bias="0.0003" drift="2e-5" corr_time="300"/>
            <xacro:imu_noise axis="y" white="0.0005" bias="0.0003" drift="2e-5" corr_time="300"/>
            <xacro:imu_noise axis="z" white="0.0005" bias="0.0003" drift="2e-5" corr_time="300"/>
          </angular_velocity>
          <linear_acceleration>
            <xacro:imu_noise axis="x" white="0.005" bias="0.01" drift="2e-4" corr_time="300"/>
            <xacro:imu_noise axis="y" white="0.005" bias="0.01" drift="2e-4" corr_time="300"/>
            <xacro:imu_noise axis="z" white="0.005" bias="0.01" drift="2e-4" corr_time="300"/>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
    <gazebo>
      <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    </gazebo>
  </xacro:macro>

  <!-- GNSS antenna: a NavSat receiver publishing ideal latitude, longitude and altitude on
       /gnss/<name>/fix_ideal; agri_ugv_localization adds realistic RTK errors (/gnss/<name>/fix)
       and the heading from the two antennas. -->
  <xacro:macro name="gnss_antenna" params="name x z rate">
    <link name="gnss_${name}_link">
      <visual>                            <!-- antenna puck, its top at the phase centre -->
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry><cylinder radius="0.07" length="0.05"/></geometry>
        <material name="module_white"/>
      </visual>
    </link>
    <joint name="gnss_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gnss_${name}_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="gnss_${name}_link">
      <sensor name="gnss_${name}" type="navsat">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/gnss/${name}/fix_ideal</topic>
        <ignition_frame_id>gnss_${name}_link</ignition_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Gazebo's NavSat system turns positions into latitude and longitude, using the
       world's <spherical_coordinates> -->
  <xacro:macro name="gnss_system">
    <gazebo>
      <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
    </gazebo>
  </xacro:macro>

</robot>
