<?xml version="1.0"?>
<!-- Sensors on the sprung body. Gazebo's sensor systems are loaded with the robot,
     so every world gets them. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU errors per axis (assumed, typical of an industrial MEMS IMU): white noise per sample,
       a bias drawn at start-up, and a slowly drifting bias with long-run spread 'drift' and
       correlation time 'corr_time'. Gazebo's dynamic_bias_stddev is a noise density: its
       long-run spread is dynamic_bias_stddev * sqrt(corr_time / 2), hence the conversion. -->
  <xacro:macro name="imu_noise" params="axis white bias drift corr_time">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0</mean>
        <stddev>${white}</stddev>
        <bias_mean>0</bias_mean>
        <bias_stddev>${bias}</bias_stddev>
        <dynamic_bias_stddev>${drift * sqrt(2.0 / corr_time)}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${corr_time}</dynamic_bias_correlation_time>
      </noise>
    </xacro:element>
  </xacro:macro>

  <!-- IMU: accelerometer and gyroscope with noise and biases, published on /imu. Like the
       real robot's inertial unit, it sits under the roof at the back (Esser et al. 2023).
       Its orientation output stays perfect in Gazebo, so the localization does not use it. -->
  <xacro:macro name="imu_sensor" params="x z rate">
    <link name="imu_link">
      <visual>
        <geometry><box size="0.16 0.12 0.06"/></geometry>
        <material name="scanner_blue"/>
      </visual>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <imu>
          <angular_velocity>
            <xacro:imu_noise axis="x" white="0.0005" bias="0.0003" drift="2e-5" corr_time="300"/>
            <xacro:imu_noise axis="y" white="0.0005" bias="0.0003" drift="2e-5" corr_time="300"/>
            <xacro:imu_noise axis="z" white="0.0005" bias="0.0003" drift="2e-5" corr_time="300"/>
          </angular_velocity>
          <linear_acceleration>
            <xacro:imu_noise axis="x" white="0.005" bias="0.01" drift="2e-4" corr_time="300"/>
            <xacro:imu_noise axis="y" white="0.005" bias="0.01" drift="2e-4" corr_time="300"/>
            <xacro:imu_noise axis="z" white="0.005" bias="0.01" drift="2e-4" corr_time="300"/>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
    <gazebo>
      <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    </gazebo>
  </xacro:macro>

  <!-- GNSS antenna: a NavSat receiver publishing ideal latitude, longitude and altitude on
       /gnss/<name>/fix_ideal; agri_ugv_localization adds realistic RTK errors (/gnss/<name>/fix)
       and the heading from the two antennas. -->
  <xacro:macro name="gnss_antenna" params="name x z rate">
    <link name="gnss_${name}_link">
      <visual>                            <!-- antenna puck, its top at the phase centre -->
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry><cylinder radius="0.07" length="0.05"/></geometry>
        <material name="module_white"/>
      </visual>
    </link>
    <joint name="gnss_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gnss_${name}_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="gnss_${name}_link">
      <sensor name="gnss_${name}" type="navsat">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/gnss/${name}/fix_ideal</topic>
        <ignition_frame_id>gnss_${name}_link</ignition_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Gazebo's NavSat system turns positions into latitude and longitude, using the
       world's <spherical_coordinates> -->
  <xacro:macro name="gnss_system">
    <gazebo>
      <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
    </gazebo>
  </xacro:macro>

  <!-- 3D LiDAR for driving: a spinning LiDAR like an Ouster OS0-64 (64 beams over a 90 deg
       vertical view, 1024 points per turn) on a mast on the roof. It is an addition to the
       robot of Esser et al. 2023, which is driven by hand. The passes go forwards and
       backwards, so it looks all around; the mast lifts it high enough that its lowest
       beams (45 deg down) pass over the roof edges ahead, behind and to the sides. The point
       cloud (sensor frame lidar_link) is published on /lidar/points; range noise assumed. -->
  <xacro:macro name="lidar_sensor" params="z mast_bottom rate">
    <link name="lidar_link">
      <visual>                            <!-- sensor housing -->
        <geometry><cylinder radius="0.043" length="0.07"/></geometry>
        <material name="camera_black"/>
      </visual>
      <visual>                            <!-- mast, down to the roof -->
        <origin xyz="0 0 ${-(z - mast_bottom) / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.02" length="${z - mast_bottom}"/></geometry>
        <material name="computer_grey"/>
      </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 ${z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/lidar</topic>
        <ignition_frame_id>lidar_link</ignition_frame_id>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi - 2 * pi / 1024}</max_angle>
            </horizontal>
            <vertical>
              <samples>64</samples>
              <resolution>1</resolution>
              <min_angle>${-pi / 4}</min_angle>
              <max_angle>${pi / 4}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>50.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Laser line scanner (sensor): a fan of 'samples' rays, 'fan' wide, in the plane
       across the robot that holds the scanner's central ray (link line_scanner_<side>_link,
       payload.xacro: 50 deg from vertical, towards the middle). Like the robot's LMI Gocator
       2490 scanners (Esser et al. 2023): range 0.39-2 m; the fan width, the noise and the
       profile rate (the real one: 200 per second) are assumed, the rate much lower: each
       profile costs rendering time. Each profile is published on /scanners/<side> (LaserScan) in the
       frame line_scanner_<side>_beam_link: x along the central ray, the fan in its x-y
       plane. Driving along the rows, the profiles add up to the plants' 3D shape. -->
  <xacro:macro name="line_scanner_sensor" params="side rate samples fan">
    <link name="line_scanner_${side}_beam_link"/>
    <joint name="line_scanner_${side}_beam_joint" type="fixed">
      <parent link="line_scanner_${side}_link"/>
      <child link="line_scanner_${side}_beam_link"/>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
    </joint>
    <gazebo reference="line_scanner_${side}_beam_link">
      <sensor name="line_scanner_${side}" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/scanners/${side}</topic>
        <ignition_frame_id>line_scanner_${side}_beam_link</ignition_frame_id>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-fan / 2}</min_angle>
              <max_angle>${fan / 2}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.39</min>
            <max>2.0</max>
            <resolution>0.0001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0005</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Dome camera (sensor): one of the 20 cameras of the dome (payload.xacro), looking along
       +x of dome_camera_<index>_link at the plant under the robot. The real ones are Nikon Z7
       (45 megapixels, Esser et al. 2023); here a small image, a few per second, assumed lens:
       every image renders the plants. The image is taken just in front of the lens, from
       dome_camera_<index>_optical_link (x forward, as the camera link), and published on
       /cameras/dome_<index>/image, its calibration on /cameras/dome_<index>/camera_info. -->
  <xacro:macro name="dome_camera_sensor" params="index rate width height fov">
    <link name="dome_camera_${index}_optical_link"/>
    <joint name="dome_camera_${index}_optical_joint" type="fixed">
      <parent link="dome_camera_${index}_link"/>
      <child link="dome_camera_${index}_optical_link"/>
      <origin xyz="0.095 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="dome_camera_${index}_optical_link">
      <sensor name="dome_camera_${index}" type="camera">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/cameras/dome_${index}/image</topic>
        <ignition_frame_id>dome_camera_${index}_optical_link</ignition_frame_id>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- the dome cameras first..last (indices) as sensors -->
  <xacro:macro name="dome_camera_sensors" params="first last rate width height fov">
    <xacro:dome_camera_sensor index="${first}" rate="${rate}" width="${width}"
                              height="${height}" fov="${fov}"/>
    <xacro:if value="${first &lt; last}">
      <xacro:dome_camera_sensors first="${first + 1}" last="${last}" rate="${rate}"
                                 width="${width}" height="${height}" fov="${fov}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Gazebo's Sensors system renders the camera-like sensors (LiDAR, line scanners, cameras)
       with Ogre 2 -->
  <xacro:macro name="rendering_system">
    <gazebo>
      <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
