<?xml version="1.0"?>
<!-- ros2_control in Gazebo: each steering joint takes a position command,
     each wheel joint a velocity command. The suspension stays passive. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="steer_joint_interface" params="prefix">
    <joint name="${prefix}_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel_joint_interface" params="prefix">
    <joint name="${prefix}_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="gazebo_control" params="controllers_file">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:steer_joint_interface prefix="front_left"/>
      <xacro:steer_joint_interface prefix="front_right"/>
      <xacro:steer_joint_interface prefix="rear_left"/>
      <xacro:steer_joint_interface prefix="rear_right"/>
      <xacro:wheel_joint_interface prefix="front_left"/>
      <xacro:wheel_joint_interface prefix="front_right"/>
      <xacro:wheel_joint_interface prefix="rear_left"/>
      <xacro:wheel_joint_interface prefix="rear_right"/>
    </ros2_control>

    <!-- The Gazebo plugin that runs ros2_control inside the simulation -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>
        <!-- Ground truth: Gazebo publishes the robot's true pose and velocity (no noise).
         The pose is base_footprint in the Gazebo world frame. The velocity is the change
         in pose per physics step, averaged over the last 10 steps (10 ms with 1 ms steps). -->
    <gazebo>
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/ground_truth/odom</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
