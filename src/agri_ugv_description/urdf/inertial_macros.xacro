<?xml version="1.0"?>
<!-- Inertia of simple solid shapes. Formulas: standard solid box and solid cylinder.
     xyz / rpy: where the centre of mass sits in the link, and how the shape is turned. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box with side lengths x, y, z [m] -->
  <xacro:macro name="box_inertial" params="mass x y z xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12.0 * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${mass / 12.0 * (x*x + z*z)}" iyz="0.0"
               izz="${mass / 12.0 * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder whose axis is its local z axis -->
  <xacro:macro name="cylinder_inertial" params="mass radius length xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12.0 * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${mass / 12.0 * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${mass / 2.0 * radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
