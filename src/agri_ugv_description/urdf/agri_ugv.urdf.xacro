<?xml version="1.0"?>
<robot name="agri_ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="gazebo_control.xacro"/>
  <xacro:include filename="soil.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="payload.xacro"/>

  <!-- Path to the controller settings; empty = no ros2_control (e.g. RViz only) -->
  <xacro:arg name="controllers_file" default=""/>
  <!-- Soil profile in Gazebo: rigid (default, no slip model), firm, soft or wet (soil.xacro) -->
  <xacro:arg name="soil" default="rigid"/>
  <!-- The 3D LiDAR on the roof (sensors.xacro); false leaves it out, e.g. to save rendering -->
  <xacro:arg name="lidar" default="true"/>
  <!-- The two laser line scanners as sensors (sensors.xacro); false: visual only -->
  <xacro:arg name="scanners" default="true"/>
  <!-- their profiles per second; each one costs rendering time (the real ones: 200) -->
  <xacro:arg name="scanner_rate" default="10"/>
  <!-- The dome cameras as sensors (sensors.xacro): none (visual only), top (the 4 of the top
       ring, looking down at the plant) or all 20; each image costs rendering time -->
  <xacro:arg name="cameras" default="none"/>
  <!-- their images per second -->
  <xacro:arg name="camera_rate" default="2"/>
  <!-- ============ Dimensions (sources: docs/robot_spec.md) ============ -->
  <xacro:property name="track"           value="1.50"/>   <!-- left-right wheel spacing -->
  <xacro:property name="wheelbase"       value="1.35"/>   <!-- front-rear steering axes -->
  <xacro:property name="wheel_radius"    value="0.205"/>
  <xacro:property name="wheel_width"     value="0.165"/>
  <xacro:property name="box_size"        value="1.50"/>   <!-- enclosure footprint -->
  <xacro:property name="box_bottom_z"    value="0.45"/>   <!-- above ground -->
  <xacro:property name="box_top_z"       value="1.85"/>   <!-- above ground -->
  <xacro:property name="panel_thickness" value="0.02"/>
  <xacro:property name="steer_z"         value="0.70"/>   <!-- steering motor height above ground (estimated) -->
  <xacro:property name="susp_travel"     value="0.05"/>   <!-- +/- 5 cm, 0.10 m total (assumed) -->
  <xacro:property name="steer_limit"     value="${pi/2}"/> <!-- +/- 90 degrees -->

  <!-- ============ Masses (assumed; see docs/robot_spec.md) ============ -->
  <xacro:property name="enclosure_mass"  value="100.0"/>  <!-- enclosure, sensors, computers -->
  <xacro:property name="enclosure_com_z" value="1.40"/>   <!-- above ground -->
  <xacro:property name="chassis_mass"    value="100.0"/>  <!-- frame and batteries -->
  <xacro:property name="chassis_com_z"   value="0.80"/>   <!-- above ground -->
  <xacro:property name="steer_mass"      value="4.0"/>    <!-- per module: steering motor -->
  <xacro:property name="leg_mass"        value="6.0"/>    <!-- per module: leg, suspension, drive motor -->
  <xacro:property name="wheel_mass"      value="10.0"/>   <!-- per module: wheel and tyre -->

  <!-- ============ Suspension: passive spring and damper per wheel ============ -->
  <!-- Stiffness is chosen so the robot rests at mid-travel: each spring carries its
       share of the sprung weight when compressed susp_travel from full extension. -->
  <xacro:property name="gravity"               value="9.81"/>
  <xacro:property name="susp_damping_ratio"    value="0.4"/>   <!-- assumed; 0.3-0.5 is typical -->
  <xacro:property name="sprung_mass_per_wheel" value="${(enclosure_mass + chassis_mass + 4*steer_mass) / 4}"/>
  <xacro:property name="susp_stiffness"        value="${sprung_mass_per_wheel * gravity / susp_travel}"/>
  <xacro:property name="susp_damping"          value="${2 * susp_damping_ratio * sqrt(susp_stiffness * sprung_mass_per_wheel)}"/>
  <!-- Derived values: computed, never typed twice -->
  <xacro:property name="box_height" value="${box_top_z - box_bottom_z}"/>
  <xacro:property name="leg_length" value="${steer_z - wheel_radius}"/>

  <!-- ============ Colours for RViz ============ -->
  <material name="aluminium">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="module_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="rubber">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="rim_red">
    <color rgba="0.80 0.10 0.10 1.0"/>
  </material>

  <!-- ============ Reference points ============ -->
  <!-- base_footprint: on the ground, below the robot's centre -->
  <link name="base_footprint"/>

  <!-- base_link: the robot's main reference point, at wheel-axle height -->
  <link name="base_link"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============ Chassis: frame and batteries (mass only, no visual) ============ -->
  <link name="chassis">
    <xacro:box_inertial mass="${chassis_mass}" x="${box_size}" y="${box_size}" z="0.20"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_com_z - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============ Sensor enclosure ============ -->
  <!-- Roof plus left and right side panels. Front, rear and bottom are open,
       so plants pass through the robot. Link origin: centre of the bottom edge. -->
  <link name="enclosure">
    <!-- Roof -->
    <visual>
      <origin xyz="0 0 ${box_height - panel_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${box_size} ${panel_thickness}"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${box_height - panel_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${box_size} ${panel_thickness}"/>
      </geometry>
    </collision>
    <!-- Left side panel (+y) -->
    <visual>
      <origin xyz="0 ${box_size/2 - panel_thickness/2} ${box_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${panel_thickness} ${box_height}"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 ${box_size/2 - panel_thickness/2} ${box_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${panel_thickness} ${box_height}"/>
      </geometry>
    </collision>
    <!-- Right side panel (-y) -->
    <visual>
      <origin xyz="0 ${-(box_size/2 - panel_thickness/2)} ${box_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${panel_thickness} ${box_height}"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 ${-(box_size/2 - panel_thickness/2)} ${box_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${panel_thickness} ${box_height}"/>
      </geometry>
    </collision>
    <!-- Mass of the enclosure plus everything mounted in it -->
    <xacro:box_inertial mass="${enclosure_mass}" x="${box_size}" y="${box_size}" z="${box_height}"
                        xyz="0 0 ${enclosure_com_z - box_bottom_z}"/>
  </link>

  <joint name="enclosure_joint" type="fixed">
    <parent link="base_link"/>
    <child link="enclosure"/>
    <!-- base_link is at wheel-axle height, so subtract it -->
    <origin xyz="0 0 ${box_bottom_z - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============ Wheel module: one corner ============ -->
  <!-- prefix: module name, e.g. front_left
       x_sign: +1 = front, -1 = rear
       y_sign: +1 = left,  -1 = right -->
  <xacro:macro name="wheel_module" params="prefix x_sign y_sign">

    <!-- 1. Steering motor: turns everything below it around a vertical axis -->
    <link name="${prefix}_steer_link">
      <visual>
        <geometry>
          <box size="0.20 0.20 0.20"/>
        </geometry>
        <material name="module_white"/>
      </visual>
      <xacro:box_inertial mass="${steer_mass}" x="0.20" y="0.20" z="0.20"/>
    </link>

    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="${x_sign*wheelbase/2} ${y_sign*track/2} ${steer_z - wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steer_limit}" upper="${steer_limit}" effort="100" velocity="1.0"/>
    </joint>

    <!-- 2. Leg with suspension: slides up and down.
         The leg is drawn beside the wheel, on the inner side. -->
    <link name="${prefix}_leg_link">
      <visual>
        <origin xyz="0 ${-y_sign*(wheel_width/2 + 0.05)} ${-leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.10 0.06 ${leg_length}"/>
        </geometry>
        <material name="module_white"/>
      </visual>
      <xacro:box_inertial mass="${leg_mass}" x="0.10" y="0.06" z="${leg_length}"
                          xyz="0 ${-y_sign*(wheel_width/2 + 0.05)} ${-leg_length/2}"/>
    </link>

    <joint name="${prefix}_suspension_joint" type="prismatic">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_leg_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-susp_travel}" upper="${susp_travel}" effort="1000" velocity="0.5"/>
      <dynamics damping="${susp_damping}" friction="0.0"/>
    </joint>

    <!-- Spring: pushes the leg down, with zero force at full extension -->
    <gazebo reference="${prefix}_suspension_joint">
      <springReference>${-susp_travel}</springReference>
      <springStiffness>${susp_stiffness}</springStiffness>
    </gazebo>

    <!-- 3. Wheel: spins around its axle (the y axis) -->
    <link name="${prefix}_wheel_link">
      <!-- Tyre. Cylinders stand upright by default, so roll 90 deg to lay the axle along y -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber"/>
      </visual>
      <!-- Rim -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius*0.5}" length="${wheel_width + 0.01}"/>
        </geometry>
        <material name="rim_red"/>
      </visual>
      <!-- The part that touches the ground -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"
                               rpy="${pi/2} 0 0"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_leg_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- Wheel centre sits leg_length below the steering motor: exactly at axle height -->
      <origin xyz="0 0 ${-leg_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- ============ The four corners ============ -->
  <xacro:wheel_module prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:wheel_module prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:wheel_module prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:wheel_module prefix="rear_right"  x_sign="-1" y_sign="-1"/>

  <!-- ============ Sensors (sensors.xacro) ============ -->
  <xacro:property name="imu_x"      value="-0.60"/> <!-- at the back, as on the real robot -->
  <xacro:property name="imu_height" value="1.79"/>  <!-- above ground, just under the roof -->
  <xacro:imu_sensor x="${imu_x}" z="${imu_height - wheel_radius}" rate="100"/>
  <xacro:property name="gnss_height"   value="1.90"/>  <!-- antennas 5 cm above the roof -->
  <xacro:property name="gnss_baseline" value="1.20"/>  <!-- front-rear distance, gives the heading -->
  <xacro:gnss_antenna name="front" x="${gnss_baseline/2}"  z="${gnss_height - wheel_radius}" rate="10"/>
  <xacro:gnss_antenna name="rear"  x="${-gnss_baseline/2}" z="${gnss_height - wheel_radius}" rate="10"/>
  <xacro:gnss_system/>
  <xacro:property name="lidar_height" value="2.70"/>  <!-- optical centre above ground, on a mast -->
  <xacro:if value="$(arg lidar)">
    <xacro:lidar_sensor z="${lidar_height - wheel_radius}" mast_bottom="${box_top_z - wheel_radius}"
                        rate="10"/>
  </xacro:if>

  <!-- ============ Phenotyping payload (payload.xacro) ============ -->
  <xacro:payload roof_z="${box_top_z}"/>
  <!-- the line scanners measure: 300 points over 35 deg each, scanner_rate per second -->
  <xacro:if value="$(arg scanners)">
    <xacro:line_scanner_sensor side="left" rate="$(arg scanner_rate)" samples="300"
                               fan="${radians(35)}"/>
    <xacro:line_scanner_sensor side="right" rate="$(arg scanner_rate)" samples="300"
                               fan="${radians(35)}"/>
  </xacro:if>
  <!-- the cameras: 640 x 480 pixels, 60 deg wide (assumed lens) -->
  <xacro:if value="${'$(arg cameras)' == 'top'}">
    <xacro:dome_camera_sensors first="16" last="19" rate="$(arg camera_rate)" width="640"
                               height="480" fov="${radians(60)}"/>
  </xacro:if>
  <xacro:if value="${'$(arg cameras)' == 'all'}">
    <xacro:dome_camera_sensors first="0" last="19" rate="$(arg camera_rate)" width="640"
                               height="480" fov="${radians(60)}"/>
  </xacro:if>
  <xacro:if value="${'$(arg lidar)' in ('true', '1') or '$(arg scanners)' in ('true', '1')
                     or '$(arg cameras)' != 'none'}">
    <xacro:rendering_system/>
  </xacro:if>
    <!-- ============ ros2_control (only when a controllers file is given) ============ -->
  <xacro:if value="${'$(arg controllers_file)' != ''}">
    <xacro:gazebo_control controllers_file="$(arg controllers_file)"/>
    <xacro:if value="${'$(arg soil)' != 'rigid'}">
      <xacro:soil_model soil="$(arg soil)"/>
    </xacro:if>
  </xacro:if>

</robot>
