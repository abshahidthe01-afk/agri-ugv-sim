<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agri_ugv_field</name>
  <version>0.0.0</version>
  <description>Field layout: the plots of a real field trial in the world frame of the terrain.</description>
  <maintainer email="abshahidthe01@gmail.com">Abdullah Bin Shahid</maintainer>
  <license>MIT</license>

  <depend>python3-numpy</depend>
  <exec_depend>python3-pyproj</exec_depend>
  <!-- Reading shapefiles also needs pyshp (Ubuntu: python3-pyshp), which has no rosdep key. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
